rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable validation primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity blueprint validation (matches firebase-blueprint.json UserAccount)
    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'favorites',
          'recentIds',
          'playCounts',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'favorites',
          'recentIds',
          'playCounts',
          'achievements',
          'equippedFlair',
          'coins',
          'lifetimeCoins',
          'unlockedThemes',
          'equippedTheme',
          'hwDone',
          'quizCorrect',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.favorites is list
        && data.favorites.size() <= 50
        && (data.favorites.size() == 0 || (data.favorites[0] is string && data.favorites[0].size() >= 1 && data.favorites[0].size() <= 64))
        && data.recentIds is list
        && data.recentIds.size() <= 6
        && (data.recentIds.size() == 0 || (data.recentIds[0] is string && data.recentIds[0].size() >= 1 && data.recentIds[0].size() <= 64))
        && data.playCounts is map
        && data.playCounts.size() <= 50
        && (!('achievements' in data) || (
          data.achievements is list
          && data.achievements.size() <= 30
          && (data.achievements.size() == 0 || (data.achievements[0] is string && data.achievements[0].size() >= 1 && data.achievements[0].size() <= 64))
        ))
        && (!('equippedFlair' in data) || (
          data.equippedFlair is string
          && data.equippedFlair.size() <= 64
          && (data.equippedFlair == '' || data.equippedFlair.matches('^[a-zA-Z0-9_\\-]+$'))
        ))
        && (!('coins' in data) || (data.coins is int && data.coins >= 0 && data.coins <= 1000000))
        && (!('lifetimeCoins' in data) || (data.lifetimeCoins is int && data.lifetimeCoins >= 0 && data.lifetimeCoins <= 1000000))
        && (!('unlockedThemes' in data) || (
          data.unlockedThemes is list
          && data.unlockedThemes.size() <= 20
          && (data.unlockedThemes.size() == 0 || (data.unlockedThemes[0] is string && data.unlockedThemes[0].size() >= 1 && data.unlockedThemes[0].size() <= 64))
        ))
        && (!('equippedTheme' in data) || (
          data.equippedTheme is string
          && data.equippedTheme.size() <= 64
          && (data.equippedTheme == '' || data.equippedTheme.matches('^[a-zA-Z0-9_\\-]+$'))
        ))
        && (!('hwDone' in data) || (
          data.hwDone is list
          && data.hwDone.size() <= 50
          && (data.hwDone.size() == 0 || (data.hwDone[0] is string && data.hwDone[0].size() >= 1 && data.hwDone[0].size() <= 64))
        ))
        && (!('quizCorrect' in data) || (data.quizCorrect is int && data.quizCorrect >= 0 && data.quizCorrect <= 100000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // Strict owner-only read; prevent collection-wide PII scraping
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      // Account creation by verified owner with server timestamps
      allow create: if isEmailVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Action-based update preserving immutable uid & createdAt with server updatedAt
      allow update: if isEmailVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Sync favorites, recent history, play counts, achievements, coins, themes, or homework progress
          incoming().diff(existing()).affectedKeys().hasOnly([
            'favorites',
            'recentIds',
            'playCounts',
            'achievements',
            'equippedFlair',
            'coins',
            'lifetimeCoins',
            'unlockedThemes',
            'equippedTheme',
            'hwDone',
            'quizCorrect',
            'updatedAt'
          ])
          ||
          // Action 2: Refresh profile details from auth provider
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'photoURL',
            'updatedAt'
          ])
          ||
          // Action 3: Combined profile + progress merge on login
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'photoURL',
            'favorites',
            'recentIds',
            'playCounts',
            'achievements',
            'equippedFlair',
            'coins',
            'lifetimeCoins',
            'unlockedThemes',
            'equippedTheme',
            'hwDone',
            'quizCorrect',
            'updatedAt'
          ])
        );

      allow delete: if isEmailVerified() && isOwner(userId) && isValidId(userId);
    }
  }
}
